\begin{tikzpicture}
  \begin{scope}[scale = 5]
    \def\slingringsmonn{.2}
    \def\majorradius{1}
    \def\minorradius{.5}

    \draw[-latex, thick] ({-\slingringsmonn}, 0)--({\majorradius + \slingringsmonn}, 0);
    \draw[-latex, thick] (0, {-\slingringsmonn})--(0, {\minorradius + \slingringsmonn});
    \draw[thick] (\majorradius, .05)--(\majorradius, -.05) node[below]{$a$};
    \draw[thick] (.05, \minorradius)--(-.05, \minorradius) node[left]{$b$};

    \foreach \eta in  {
      0,
      0.538784702588300,
      0.934187593969708,
      1.264468876320687,
      1.570796326794897
    } {
      \draw[fill = white] ({\majorradius*cos(\eta r)}, {\minorradius*sin(\eta r)}) circle (.01);
    }
  \end{scope}
\end{tikzpicture}