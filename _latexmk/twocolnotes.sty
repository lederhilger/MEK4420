%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%% MULTICOL PATCHES %%%%%%%%%%%%%%%%%%%%%%%
\let\tcf@latex@balance@columns@out\balance@columns@out
\def\balance@columns@out{%
  \ifnum\col@number=\tw@
    \ifvoid\tcf@ins
      \tcf@bodylast=\tcf@lastnote
      \tcf@getreadylast
      \ifnum\tcf@readylast=\tcf@placed
        \ifnum\tcf@lastnote>\tcf@placed
          \tcf@release
          \global\tcf@placed=\tcf@lastnote
        \fi
        \tcf@latex@balance@columns@out
      \else
        \multi@column@out \penalty-\@Mvi
      \fi
    \else
      \multi@column@out \penalty-\@Mvi
    \fi
  \else
    \tcf@latex@balance@columns@out
  \fi%
}

\patchcmd\multi@column@out
  {%
    \ifvbox \@kludgeins
      \advance \dimen@ -\ht\@kludgeins
      \ifdim \wd\@kludgeins>\z@
        \shr@nkingtrue
      \fi
    \fi%
  }
  {%
    \ifvbox \@kludgeins
      \advance \dimen@ -\ht\@kludgeins
      \ifdim \wd\@kludgeins>\z@
        \shr@nkingtrue
      \fi
    \fi
    \tcf@prepare%
  }
  {}
  {%
    \PackageError{twocolnotes}
      {Unsupported multicol output routine}
      {}%
  }
\patchcmd\multi@column@out
  {\ifvoid\@cclv \else}
  {\tcf@restorebody\ifvoid\@cclv \else}
  {}
  {%
    \PackageError{twocolnotes}
      {Cannot restore held body material}
      {}%
  }
\patchcmd\multi@column@out
  {\@makecol\@outputpage}
  {\tcf@putfootins\@makecol\@outputpage}
  {}
  {%
    \PackageError{twocolnotes}
      {Cannot install page footnotes}
      {}%
  }
\patchcmd\endmulticols
  {\penalty-\@Mvi}
  {\penalty-\@Mvi\tcf@flush\tcf@clearqueue}
  {}
  {%
    \PackageError{twocolnotes}
      {Cannot install continuation flushing}
      {}%
  }
