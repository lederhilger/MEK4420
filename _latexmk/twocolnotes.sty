%%%%%%%%%%%%%%%%%%%%%%%% INITIALIZATION %%%%%%%%%%%%%%%%%%%%%%%%
\AtBeginDocument{%
  \tcf@fullwidth=\textwidth
  \tcf@columnwidth=\tcf@fullwidth
  \advance\tcf@columnwidth-\columnsep
  \divide\tcf@columnwidth\tw@
  \let\tcf@latex@footnotetext\@footnotetext
  \let\tcf@latex@xfootnotenext\@xfootnotenext
  \let\tcf@latex@footnote\footnote
  \let\tcf@latex@footnotemark\footnotemark
  \let\@footnotetext\tcf@footnotetext
  \let\@xfootnotenext\tcf@xfootnotenext
  \def\footnote{%
    \@ifnextchar[%
      \tcf@xfootnote
      \tcf@footnote%
  }%
  \def\footnotemark{%
    \@ifnextchar[%
      \tcf@xfootnotemark
      \tcf@footnotemark%
  }%
}
\endinput
