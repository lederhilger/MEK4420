\newfontfamily\gothicfont{Ulfilas}
\DeclareRobustCommand{\Othal}{%
  \TextOrMath
    {%
      \BeginAccSupp{method=pdfstringdef,unicode,ActualText={𐍉}}%
      {\gothicfont O}%
      \EndAccSupp{}%
    }%
    {%
      \mathord{\text{%
          \BeginAccSupp{method=pdfstringdef,unicode,%
            ActualText={𐍉}}%
        {\gothicfont O}%
        \EndAccSupp{}%
      }}%
    }%
}
