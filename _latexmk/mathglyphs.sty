%%%%%%%%%%%%%%%%%%%%%%% DISPLACED VOLUME %%%%%%%%%%%%%%%%%%%%%%%
\newsavebox{\displacedvolumeVbox}
\newsavebox{\displacedvolumetildebox}
\newdimen\displacedvolumeraise
\newdimen\displacedvolumeshift
\newcommand{\displacedvolumeaux}[2]{%
  \begingroup
  \sbox{\displacedvolumeVbox}{$\m@th#1%
    \BeginAccSupp{method = hex, unicode, ActualText = D800DD97}%
    \text{\normalfont\itshape V}%
    \EndAccSupp{}$}%
  \sbox{\displacedvolumetildebox}{%
    \scalebox{1.0833333333}{$\m@th#1%
      \BeginAccSupp{ActualText = {}}%
      \text{\normalfont\itshape\symbol{"007E}}%
      \EndAccSupp{}$}}%
  \displacedvolumeraise=.241\ht\displacedvolumeVbox
  \displacedvolumeshift=.109\wd\displacedvolumeVbox
  \ooalign{%
    \hfil\copy\displacedvolumeVbox\hfil\crcr
    \hidewidth\hskip\displacedvolumeshift
      \raise\displacedvolumeraise\copy\displacedvolumetildebox
    \hidewidth\crcr}%
  \endgroup}
\DeclareRobustCommand{\displacedvolume}{%
  \ifmmode
    \mathord{\mathpalette\displacedvolumeaux\relax}%
  \else
    \ensuremath{\displacedvolume}%
  \fi}
